{
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://dnp64f-745wi6899-arcadawebapps2.vercel.app/assets/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://dnp64f-745wi6899-arcadawebapps2.vercel.app/media/:path*"
    },
    {
      "source": "/((?!assets/|media/|favicon.svg|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
